{
  "name": "basic-pitch-midi",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "main": "dist/extension.js",
  "engines": { "node": ">=22.11.0" },
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts --production",
    "build:dev": "tsc --noEmit && tsx build.ts",
    "start": "npm run build:dev && extensions-cli run",
    "package": "npm run build && extensions-cli package -i model",
    "test": "vitest run"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.0.tgz",
    "@spotify/basic-pitch": "^1.0.1",
    "audio-decode": "^2.2.3"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^25.9.1",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.1"
  }
}
